{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-hooks"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/immutability": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn"
  },
  "ignorePatterns": ["dist"]
}
