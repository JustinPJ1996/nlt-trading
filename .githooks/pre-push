#!/bin/sh
# The slow half of the gate. This repo is public and will hold broker
# credentials, so the secret scan runs before anything leaves the machine.
#
# Mutation testing is deliberately NOT here -- it takes long enough that putting
# it in a hook would train you to use --no-verify. Run `make mutation` when you
# have written tests worth trusting.

# Git hooks run with a minimal PATH that does not include the mise shims, so a
# tool installed with `mise use -g` is invisible here even though it works fine
# in a terminal. Put the shims back before looking for anything.
PATH="/opt/mise/shims:$HOME/.local/bin:$PATH"
export PATH

# This used to `echo "skipping"` and exit 0 when gitleaks was missing, which is
# how a push went out unscanned: mise's config lives in the bind-mounted home
# and survives, but the installed binary does not, so after the container was
# rebuilt the config still requested gitleaks while the tool itself was gone.
# `mise ls` said "(missing)". The hook said "skipping" and returned success.
#
# A security check that cannot run must block, not wave the push through. The
# failure mode of being too strict is an error message; the failure mode of
# being too lenient is a credential on a public repo, discovered later by
# someone else.
if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-push BLOCKED: gitleaks is not installed, so history cannot be scanned."
	echo
	echo "  This repo is public. Pushing without the scan is not the safe default."
	echo
	echo "  Fix it with:  mise install        (the version is already pinned)"
	echo "  Or, if you have genuinely decided the risk is acceptable:"
	echo "                git push --no-verify"
	exit 1
fi

echo "pre-push: scanning history for secrets"
make secrets || exit 1
